flowchart LR
    User(("User<br/>/ Renter"))
    Approver(("Approver<br/>/ Fleet Manager"))
    Scheduler(("System<br/>/ Scheduler"))

    %% Approver inherits all User use cases
    Approver -- "<<inherits>>" --> User

    subgraph System["AutoRepo reservation system (v0.3)"]
        direction TB
        UC1(["UC-01<br/>Create reservation"])
        UC2(["UC-02<br/>Check availability"])
        UC3(["UC-03<br/>Confirm reservation"])
        UC4(["UC-04<br/>Cancel reservation"])
        UC5(["UC-05<br/>Approve reservation"])
        UC6(["UC-06<br/>Reject reservation"])
        UC7(["UC-07<br/>Expire pending reservation"])
    end

    User --> UC1
    User --> UC2
    User --> UC3
    User --> UC4
    Approver --> UC5
    Approver --> UC6
    Scheduler --> UC7

    classDef actor fill:#fff,stroke:#334155,stroke-width:2px,color:#0f172a
    classDef query fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e
    classDef command fill:#dcfce7,stroke:#16a34a,color:#14532d
    classDef approval fill:#ffedd5,stroke:#ea580c,color:#7c2d12
    classDef cancel fill:#fee2e2,stroke:#dc2626,color:#7f1d1d
    classDef automation fill:#eceff1,stroke:#546e7a,color:#263238
    class User,Approver,Scheduler actor
    class UC2 query
    class UC1,UC3 command
    class UC4 cancel
    class UC5,UC6 approval
    class UC7 automation
    style System fill:#f8fafc,stroke:#475569,stroke-width:2px
