flowchart TD
    startNode((Start)) --> Step1["Step 1: Browse cars & enter time window"]

%% OP-02 Check Availability
    Step1 --> OP02["OP-02: Check Availability"]
    OP02 --> CheckAvail{"Is Car Available in [start, end)?"}
    CheckAvail -- No --> PickAnother["Select another car or interval"]
    PickAnother --> OP02
    CheckAvail -- Yes --> Step2["Step 2: Put in basket / Fill details"]

%% OP-01 Create Reservation
    Step2 --> OP01["OP-01: Create Reservation"]
    OP01 --> CreateDraft["System creates Reservation in DRAFT state<br>- Intent recorded<br>- Car NOT yet locked"]

%% Decision to proceed
    CreateDraft --> DecideConfirm{"User proceeds to checkout?"}
    DecideConfirm -- Abandon / Cancel --> CancelDraft["OP-04: Cancel Reservation<br>State: CANCELLED"]
    CancelDraft --> EndDraftCancel((End))

%% OP-03 Confirm Reservation
    DecideConfirm -- Click 'Complete Booking' --> OP03["OP-03: Confirm Reservation"]
    OP03 --> CheckConflict{"Conflict check:<br>Any overlapping CONFIRMED bookings?"}

    CheckConflict -- Yes / Collision --> RejectConfirm["Booking Rejected<br>Remains DRAFT"]
    RejectConfirm --> Step1

    CheckConflict -- No --> CommitConfirm["System commits allocation<br>State: CONFIRMED<br>Car is now locked!"]

%% Post-confirmation / Cancel
    CommitConfirm --> HasPlanChanged{"Change of plans before start time?"}
    HasPlanChanged -- No --> UseCar["User picks up car at start time"]
    UseCar --> EndCompleted((Trip Finished))

    HasPlanChanged -- "Yes: currentTime < start" --> OP04["OP-04: Cancel Reservation"]
    OP04 --> ReleaseLock["State: CANCELLED<br>Car is released back to inventory"]
    ReleaseLock --> EndCancelled((End))