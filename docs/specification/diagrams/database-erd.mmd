%%{init: {"theme": "base", "er": {"layoutDirection": "LR"}}}%%
erDiagram
    USERS ||--o{ RESERVATIONS : places
    VEHICLES ||--o{ RESERVATIONS : assigned_to

    USERS {
        bigint id PK
        varchar full_name
        varchar email
        varchar role
    }

    VEHICLES {
        bigint id PK
        varchar brand
        varchar model
        varchar vin
        varchar license_plate UK
        boolean is_active
        boolean requires_approval
    }

    RESERVATIONS {
        bigint id PK
        bigint vehicle_id FK
        bigint user_id FK
        timestamp start_time
        timestamp end_time
        varchar state "DRAFT | PENDING_APPROVAL | CONFIRMED | REJECTED | CANCELLED | EXPIRED"
        timestamp created_at
    }
