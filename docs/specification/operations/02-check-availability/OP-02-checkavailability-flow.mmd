flowchart TD
    startNode((Start)) --> ReceiveQuery["Receive Availability Query<br>(resource_id, start_time, end_time)"]

    ReceiveQuery --> CheckRes{"Target Car<br>exists?"}
    CheckRes -- No --> ErrRes["Return error:<br>RESOURCE_NOT_FOUND"]
    ErrRes --> endErr1((End With Error))

    CheckRes -- Yes --> CheckSyntax{"Is start < end<br>(BR-01)?"}
    CheckSyntax -- No --> ErrSyntax["Return error:<br>INVALID_INTERVAL"]
    ErrSyntax --> endErr2((End With Error))

    CheckSyntax -- Yes --> FetchBlocking["Query all blocking reservations<br>(CONFIRMED or PENDING_APPROVAL)"]
    FetchBlocking --> EvalOverlap{"Does any blocking reservation<br>overlap query interval?<br>max(s1,s2) < min(e1,e2)"}

    EvalOverlap -- Yes --> RetUnavail["Return Result:<br>UNAVAILABLE"]
    EvalOverlap -- No --> RetAvail["Return Result:<br>AVAILABLE"]

    RetUnavail --> endQuery((End Query))
    RetAvail --> endQuery